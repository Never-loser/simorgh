# Build output
cpp/build/
build/
*.o
*.obj
*.exe
*.pdb
*.ilk

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors
.vscode/
.idea/

# Debug build tree
cpp/dbg/

# Learning artefacts.
# The book and the active weights ARE the learned knowledge, so they are
# tracked. Everything else here is bulk training data or a scratch
# candidate and regenerates from a training run.
data/positions.txt
data/snapshot.txt
data/weights.candidate.txt
data/weights.previous.txt
data/positions.quiet.txt

# Downloaded game collections. These are third-party PGN files, not part of
# the project; importpgn.py turns them into data/book.txt, which is what
# actually needs to be tracked.
pgn/
data/book.gm.txt
data/book.selfplay-backup.txt

# Reference engine used only for strength measurement, not part of the project.
tools/

# Lichess API token. Never commit this.
data/lichess_token.txt

# Extracted training positions. Regenerated by importpgn.py --positions
# from the PGN collections; large and not part of the project.
data/gm_positions.txt
data/gm_quiet.txt
data/weights.material.txt
